# Kopiraj v .env in izpolni.
PORT=3000
# MongoDB (npr. brezplačni MongoDB Atlas). Brez tega prijava ne deluje.
MONGODB_URI=mongodb+srv://uporabnik:geslo@cluster0.example.mongodb.net/piflar
# Dolg naključen niz, npr.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Stripe (https://dashboard.stripe.com/apikeys). Brez tega plačila niso na voljo.
STRIPE_SECRET_KEY=sk_test_...
# Developers → Webhooks → naslov https://<domena>/api/placila/webhook,
# dogodka checkout.session.completed in invoice.paid
STRIPE_WEBHOOK_SECRET=whsec_...
# Javni naslov strani (za povratek iz Stripe), npr. https://piflar.si
JAVNI_URL=http://localhost:3000
# Id-ji cen iz Stripe (Products → cena → price_...).
# mesecno/letno: ponavljajoča se cena; solsko: enkratna cena za 10 mesecev.
STRIPE_CENA_OSNOVNI_MESECNO=
STRIPE_CENA_OSNOVNI_LETNO=
STRIPE_CENA_OSNOVNI_SOLSKO=
STRIPE_CENA_PREMIUM_MESECNO=
STRIPE_CENA_PREMIUM_LETNO=
STRIPE_CENA_PREMIUM_SOLSKO=
